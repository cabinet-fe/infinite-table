{
  "name": "infinitable",
  "private": true,
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -b && bun run --filter './packages/*' build",
    "test": "vp test run",
    "check": "vp check",
    "lint": "vp lint && bun run check:deps",
    "fmt": "vp fmt --write .",
    "fmt:check": "vp fmt --check .",
    "check:deps": "bun scripts/check-core-deps.ts",
    "check:exports": "node scripts/check-package-exports.mjs"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "~7.0.2",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.2"
}
